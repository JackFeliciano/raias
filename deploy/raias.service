[Unit]
Description=RAIAS accounting analysis
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/raias
Environment=RAIAS_BASE=/raias/
ExecStart=/usr/bin/php -S 127.0.0.1:8121 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/raias
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
